# ───────────── 20Mart environment template ─────────────
# Copy values into:
#   packages/database/.env       (Prisma CLI, seeds, admin bootstrap)
#   apps/20mart/.env.local       (storefront)
#   apps/20martadmin/.env.local  (admin)
#   packages/server/.env.test    (test suite; must point at a disposable DB)
# Never commit real values.

# PostgreSQL (least-privilege app role; CREATEDB only needed in dev for Prisma's shadow DB)
DATABASE_URL="postgresql://twentymart_app:CHANGE_ME@localhost:5432/twentymart_dev?schema=public"
DATABASE_URL_TEST="postgresql://twentymart_app:CHANGE_ME@localhost:5432/twentymart_test?schema=public"

# 32+ random bytes, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""

# Public origins (used for OAuth redirect URIs, CSRF origin checks, links)
APP_URL="http://localhost:3000"
ADMIN_APP_URL="http://localhost:3001"

# Google OAuth (storefront only). Redirect URI: ${APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Shared secret the admin uses to trigger storefront cache revalidation
REVALIDATE_SECRET=""

# Image storage: "local" (dev) or "s3" (AWS S3 / Cloudflare R2 / any S3-compatible)
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="/absolute/path/to/20Mart/storage/uploads"
STORAGE_PUBLIC_BASE_URL="http://localhost:3000/media"
S3_ENDPOINT=""          # e.g. https://<accountid>.r2.cloudflarestorage.com or https://s3.ap-south-1.amazonaws.com
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# One-time SUPER_ADMIN bootstrap (packages/database/.env). Remove the password after use.
INITIAL_ADMIN_USERNAME=""
INITIAL_ADMIN_EMAIL=""
INITIAL_ADMIN_PASSWORD=""
