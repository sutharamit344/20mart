# ───────────── 20Mart environment template ─────────────
# Copy values into:
#   packages/database/.env       (Prisma CLI, seeds, admin bootstrap)
#   apps/20mart/.env.local       (storefront)
#   apps/20martadmin/.env.local  (admin)
#   packages/server/.env.test    (test suite; must point at a disposable DB)
# Never commit real values.

# PostgreSQL (least-privilege app role; CREATEDB only needed in dev for Prisma's shadow DB)
DATABASE_URL="postgresql://twentymart_app:CHANGE_ME@localhost:5432/twentymart_dev?schema=public"
DATABASE_URL_TEST="postgresql://twentymart_app:CHANGE_ME@localhost:5432/twentymart_test?schema=public"

# 32+ random bytes, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""

# Public origins (used for OAuth redirect URIs, CSRF origin checks, links)
APP_URL="http://localhost:3000"
ADMIN_APP_URL="http://localhost:3001"

# Google OAuth (storefront only). Redirect URI: ${APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Shared secret the admin uses to trigger storefront cache revalidation
REVALIDATE_SECRET=""

# Image storage: "local" (dev) or "s3" (AWS S3 / Cloudflare R2 / any S3-compatible)
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="/absolute/path/to/20Mart/storage/uploads"
STORAGE_PUBLIC_BASE_URL="http://localhost:3000/media"
S3_ENDPOINT=""          # e.g. https://<accountid>.r2.cloudflarestorage.com or https://s3.ap-south-1.amazonaws.com
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# One-time SUPER_ADMIN bootstrap (packages/database/.env). Remove the password after use.
INITIAL_ADMIN_USERNAME=""
INITIAL_ADMIN_EMAIL=""
INITIAL_ADMIN_PASSWORD=""

# ───────────── P1: payments & jobs ─────────────
# Razorpay (online payment stays disabled until all three are set AND enabled in Admin → Delivery & Payments)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Webhook URL to configure in Razorpay: ${APP_URL}/api/payments/razorpay/webhook
# Events: payment.captured, payment.failed, order.paid, refund.processed, refund.failed
RAZORPAY_WEBHOOK_SECRET=""
# Secret for POST ${APP_URL}/api/cron/expire-reservations (header x-cron-secret); schedule every 5 minutes
CRON_SECRET=""

# ───────────── P2: email (Resend) ─────────────
# Email is off until both are set. EMAIL_FROM must use a domain verified in Resend, e.g. "20Mart <orders@yourdomain.in>"
RESEND_API_KEY=""
EMAIL_FROM=""             # MAIL_FROM is accepted as an alias
# Webhook URL to configure in Resend: ${APP_URL}/api/email/resend/webhook
# Events: email.delivered, email.bounced, email.complained   (secret starts with whsec_)
RESEND_WEBHOOK_SECRET=""
# Queued/failed emails are (re)sent by POST ${APP_URL}/api/cron/notifications (header x-cron-secret = CRON_SECRET); schedule every 5 minutes

# ───────────── P4: "Use my current location" (storefront) ─────────────
# Off by default: customers type their PIN code. Set ONE provider to enable GPS → PIN lookup.
#   google    = Google Geocoding API (server-side key; restrict it to the Geocoding API)
#   nominatim = OpenStreetMap Nominatim (light use only; GEOCODING_CONTACT = a contact email/URL, required by its policy)
GEOCODING_PROVIDER=""
GOOGLE_MAPS_API_KEY=""
GEOCODING_CONTACT=""

# ───────────── P3: production operations ─────────────
# DATABASE_URL in production (example):
#   postgresql://twentymart_app:<pw>@<host>:5432/twentymart?schema=public&sslmode=require&connection_limit=5&pool_timeout=20
#   connection_limit = per app instance; keep (instances × limit × 2 apps) below the server's max_connections.
#   Behind PgBouncer (transaction mode) add &pgbouncer=true and run once:  ALTER ROLE twentymart_app SET timezone = 'UTC';
# Every DB session is forced to UTC (all timestamps are UTC). Only set to "false" if the role already enforces UTC.
DATABASE_FORCE_UTC=""

# Error monitoring (optional; without it errors go to structured JSON logs on stdout/stderr only)
SENTRY_DSN=""                 # https://<key>@<org>.ingest.sentry.io/<project>
SENTRY_ENVIRONMENT=""         # defaults to NODE_ENV (e.g. "staging", "production")
MONITORING_WEBHOOK_URL=""     # optional https endpoint that receives a JSON payload per error
SERVICE_NAME=""               # e.g. "storefront" / "admin" (tags every log line)
APP_RELEASE=""                # e.g. git SHA, shown in /api/health and attached to errors
LOG_LEVEL="info"              # debug | info | warn | error
SLOW_REQUEST_MS="2000"        # API requests slower than this are logged as perf.slow_request

# Client IP for rate limiting / audit logs. Left-most X-Forwarded-For entries are client-controlled and ignored.
TRUST_PROXY_HOPS="1"          # number of reverse proxies in front of `next start` (nginx = 1, CDN + nginx = 2)
CLIENT_IP_HEADER=""           # e.g. "cf-connecting-ip" behind Cloudflare, "x-real-ip" if your proxy sets it

# Backups (scripts/db/backup.mjs). PG_BIN only if pg_dump/psql are not on PATH.
BACKUP_DIR="./backups"
BACKUP_KEEP_DAYS="14"
BACKUP_KEEP_MIN="7"
PG_BIN=""

# Health details: GET /api/health with header x-health-secret: <CRON_SECRET> (booleans/warnings only)
# Scheduled jobs (header x-cron-secret: <CRON_SECRET>):
#   */5 * * * *  POST ${APP_URL}/api/cron/expire-reservations
#   */5 * * * *  POST ${APP_URL}/api/cron/notifications
#   15 3 * * *   POST ${APP_URL}/api/cron/maintenance       (purges expired sessions, old throttle rows, abandoned guest carts)
