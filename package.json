{
  "name": "20mart-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "dev:store": "pnpm --filter @20mart/storefront dev",
    "dev:admin": "pnpm --filter @20mart/admin dev",
    "kill:ports": "powershell -Command \"Get-NetTCPConnection -LocalPort 3000, 3001 -ErrorAction SilentlyContinue | ForEach-Object { Stop-Process -Id $_.OwningProcess -Force -ErrorAction SilentlyContinue }\"",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "db:generate": "pnpm --filter @20mart/database db:generate",
    "clean": "turbo run clean",
    "db:backup": "node --env-file=packages/database/.env scripts/db/backup.mjs",
    "db:restore-verify": "node --env-file=packages/database/.env scripts/db/restore-verify.mjs",
    "verify:deploy": "node scripts/verify-deployment.mjs",
    "test:e2e": "node scripts/e2e/run.mjs",
    "perf:measure": "node scripts/perf/measure.mjs",
    "test": "pnpm --filter @20mart/server test",
    "type-check": "turbo run type-check"
  },
  "devDependencies": {
    "turbo": "^2.4.4",
    "typescript": "^5.7.3",
    "prettier": "^3.5.2"
  },
  "packageManager": "pnpm@12.16.1"
}
