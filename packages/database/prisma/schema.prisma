// 20Mart — single-business catalog, inventory and commerce schema.
// Conventions:
//   * All money is stored as integer PAISE (₹20 = 2000). Never use floats.
//   * UUID primary keys, createdAt/updatedAt on mutable entities.
//   * Constraints Prisma cannot express (CHECKs, partial unique indexes) live in
//     the migration SQL — see migrations/*_p0_foundation/migration.sql.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ───────────────────────────── Enums ─────────────────────────────

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum AdminStatus {
  ACTIVE
  INACTIVE
}

enum CatalogStatus {
  ACTIVE
  INACTIVE
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum StockMovementType {
  INITIAL_STOCK
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
  RESERVATION
  RELEASE
  SALE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  PACKED
  READY_FOR_DISPATCH
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  FAILED
  REFUNDED // legacy value; refunds are tracked on paymentStatus
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUND_PENDING
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentProvider {
  RAZORPAY
  COD
  MANUAL
}

enum InventoryHold {
  RESERVED
  COMMITTED
  RELEASED
}

enum RefundStatus {
  REQUESTED
  PENDING
  PROCESSED
  FAILED
}

enum CartStatus {
  ACTIVE
  CONVERTED
}

enum PaymentMethod {
  ONLINE
  ONLINE_UPI
  CARD
  NET_BANKING
  CASH_ON_DELIVERY
}

enum DeliveryMethod {
  HOME_DELIVERY
  STORE_PICKUP
}

enum DiscountType {
  FIXED
  PERCENT
}

// ─────────────────────── Customer accounts ───────────────────────

/// Customer account. Identity comes from Google's stable subject id.
model User {
  id              String     @id @default(uuid())
  name            String?
  email           String?
  emailVerified   DateTime?
  image           String?
  googleSubjectId String?    @unique
  status          UserStatus @default(ACTIVE)
  lastLoginAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  profile     CustomerProfile?
  sessions    UserSession[]
  wishlist    WishlistItem[]
  addresses   Address[]
  carts       Cart[]
  orders      Order[]
  redemptions CouponRedemption[]
  responses   QuestionResponse[]

  @@index([email])
}

model CustomerProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone          String?
  marketingOptIn Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

/// Server-side customer session. Only a SHA-256 hash of the cookie token is stored.
model UserSession {
  id         String   @id @default(uuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Address {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         String   @default("Home") // Home, Work, Other
  name         String // recipient full name
  phone        String
  addressLine1 String
  addressLine2 String?
  landmark     String?
  locality     String?
  city         String
  state        String
  pincode      String
  country      String   @default("IN")
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  orders       Order[]

  @@index([userId])
}

// ───────────────────── Admin accounts & RBAC ─────────────────────

/// Staff account. Fully separate from customer `User`.
model AdminUser {
  id                String      @id @default(uuid())
  username          String      @unique
  email             String      @unique
  passwordHash      String
  name              String
  status            AdminStatus @default(ACTIVE)
  lastLoginAt       DateTime?
  failedLoginCount  Int         @default(0)
  lockedUntil       DateTime?
  passwordChangedAt DateTime    @default(now())
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  roles          AdminUserRole[]      @relation("AdminRoles")
  rolesAssigned  AdminUserRole[]      @relation("AdminRoleAssigner")
  sessions       AdminSession[]
  stockMovements StockMovement[]
  auditLogs      AdminAuditLog[]
  orderChanges   OrderStatusHistory[] @relation("OrderStatusChanger")
  orderNotes     OrderNote[]          @relation("OrderNoteAuthor")
  refunds        Refund[]             @relation("RefundInitiator")
}

model AdminSession {
  id         String    @id @default(uuid())
  tokenHash  String    @unique
  adminId    String
  admin      AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  lastSeenAt DateTime  @default(now())
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime  @default(now())

  @@index([adminId])
  @@index([expiresAt])
}

/// Login attempts used for throttling admin sign-in (per identifier and per IP).
model AdminLoginAttempt {
  id         String   @id @default(uuid())
  identifier String
  ipAddress  String?
  success    Boolean
  createdAt  DateTime @default(now())

  @@index([identifier, createdAt])
  @@index([ipAddress, createdAt])
}

model Role {
  id          String           @id @default(uuid())
  key         String           @unique // e.g. SUPER_ADMIN
  name        String
  description String?
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  admins      AdminUserRole[]
}

model Permission {
  id          String           @id @default(uuid())
  key         String           @unique // e.g. products.update
  group       String
  description String?
  createdAt   DateTime         @default(now())
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model AdminUserRole {
  adminId      String
  admin        AdminUser  @relation("AdminRoles", fields: [adminId], references: [id], onDelete: Cascade)
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  assignedById String?
  assignedBy   AdminUser? @relation("AdminRoleAssigner", fields: [assignedById], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())

  @@id([adminId, roleId])
  @@index([roleId])
}

model AdminAuditLog {
  id         String     @id @default(uuid())
  adminId    String?
  admin      AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)
  adminName  String
  action     String
  category   String
  entityType String?
  entityId   String?
  details    String
  ipAddress  String?
  createdAt  DateTime   @default(now())

  @@index([adminId])
  @@index([category])
  @@index([createdAt])
}

// ─────────────────────────── Catalog ────────────────────────────

model Category {
  id             String        @id @default(uuid())
  name           String
  slug           String        @unique
  description    String?
  imageUrl       String?
  imageKey       String?
  status         CatalogStatus @default(ACTIVE)
  displayOrder   Int           @default(0)
  seoTitle       String?
  seoDescription String?
  parentId       String?
  parent         Category?     @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children       Category[]    @relation("CategoryTree")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  products       Product[]

  @@index([status, displayOrder])
  @@index([parentId])
}

model Brand {
  id          String        @id @default(uuid())
  name        String
  slug        String        @unique
  description String?
  logoUrl     String?
  logoKey     String?
  status      CatalogStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  products    Product[]

  @@index([status])
  @@index([name])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Brand_name_trgm_idx")
}

/// Merchandising price points (₹20/₹40/₹60/₹100 initially). Admin-manageable.
model PricePoint {
  id           String    @id @default(uuid())
  amountPaise  Int       @unique
  label        String
  isActive     Boolean   @default(true)
  displayOrder Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  products     Product[]
}

model Product {
  id                String        @id @default(uuid())
  name              String
  slug              String        @unique
  sku               String        @unique
  description       String?
  shortDescription  String?
  categoryId        String
  category          Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brandId           String?
  brand             Brand?        @relation(fields: [brandId], references: [id], onDelete: Restrict)
  pricePointId      String?
  pricePoint        PricePoint?   @relation(fields: [pricePointId], references: [id], onDelete: SetNull)
  sellingPricePaise Int
  mrpPaise          Int
  status            ProductStatus @default(DRAFT)
  isFeatured        Boolean       @default(false)
  seoTitle          String?
  seoDescription    String?
  publishedAt       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  images        ProductImage[]
  variants      ProductVariant[]
  inventories   Inventory[]
  cartItems     CartItem[]
  orderItems    OrderItem[]
  questions     Question[]
  wishlistItems WishlistItem[]

  @@index([status, categoryId])
  @@index([status, isFeatured])
  @@index([status, createdAt])
  @@index([brandId])
  @@index([pricePointId])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Product_name_trgm_idx")
  @@index([sku(ops: raw("gin_trgm_ops"))], type: Gin, map: "Product_sku_trgm_idx")
}

model ProductImage {
  id         String   @id @default(uuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url        String
  storageKey String?
  altText    String?
  sortOrder  Int      @default(0)
  isPrimary  Boolean  @default(false)
  width      Int?
  height     Int?
  mimeType   String?
  sizeBytes  Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([productId, sortOrder])
}

model ProductVariant {
  id                String        @id @default(uuid())
  productId         String
  product           Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku               String        @unique
  name              String
  sellingPricePaise Int
  mrpPaise          Int
  status            CatalogStatus @default(ACTIVE)
  sortOrder         Int           @default(0)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  inventories Inventory[]
  cartItems   CartItem[]
  orderItems  OrderItem[]

  @@index([productId, sortOrder])
  @@index([sku(ops: raw("gin_trgm_ops"))], type: Gin, map: "ProductVariant_sku_trgm_idx")
}

// ────────────────────────── Inventory ───────────────────────────

/// One row per product (variantId NULL) or per variant. Uniqueness is enforced by
/// partial unique indexes in the migration SQL. Quantities are guarded by CHECKs.
model Inventory {
  id                String          @id @default(uuid())
  productId         String
  product           Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId         String?
  variant           ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  availableQuantity Int             @default(0)
  reservedQuantity  Int             @default(0)
  lowStockThreshold Int             @default(10)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  movements         StockMovement[]

  @@index([productId])
  @@index([variantId])
  @@index([availableQuantity])
}

model StockMovement {
  id                 String            @id @default(uuid())
  inventoryId        String
  inventory          Inventory         @relation(fields: [inventoryId], references: [id], onDelete: Restrict)
  movementType       StockMovementType
  quantity           Int // signed delta applied to availableQuantity (or reserved for RESERVATION/RELEASE)
  previousQuantity   Int
  newQuantity        Int
  reason             String
  reference          String?
  performedByAdminId String?
  performedBy        AdminUser?        @relation(fields: [performedByAdminId], references: [id], onDelete: SetNull)
  createdAt          DateTime          @default(now())

  @@index([inventoryId, createdAt])
  @@index([performedByAdminId])
}

// ───────────── Commerce (later phases; kept, not used in P0) ─────────────

/// Persistent cart: customer carts (userId) or guest carts (sessionId = SHA-256 of the cookie token).
model Cart {
  id        String     @id @default(uuid())
  userId    String?
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String?    @unique
  status    CartStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  items     CartItem[]

  @@index([userId, status])
  @@index([updatedAt])
}

model CartItem {
  id              String          @id @default(uuid())
  cartId          String
  cart            Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId       String
  product         Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId       String?
  variant         ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity        Int             @default(1)
  /// Price seen when added (display only, flags price changes). Never charged.
  addedPricePaise Int
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([cartId])
}

model Order {
  id                   String         @id @default(uuid())
  /// Public, non-sequential reference, e.g. ZM261114-7K3QX9
  orderNumber          String         @unique
  userId               String
  user                 User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  addressId            String?
  address              Address?       @relation(fields: [addressId], references: [id], onDelete: SetNull)
  shipName             String
  shipPhone            String
  shipLine1            String
  shipLine2            String?
  shipLandmark         String?
  shipCity             String
  shipState            String
  shipPincode          String
  shipCountry          String         @default("IN")
  status               OrderStatus    @default(PENDING)
  subtotalPaise        Int
  deliveryChargePaise  Int            @default(0)
  discountPaise        Int            @default(0)
  taxPaise             Int            @default(0)
  totalPaise           Int
  deliveryMethod       DeliveryMethod @default(HOME_DELIVERY)
  paymentMethod        PaymentMethod
  paymentStatus        PaymentStatus  @default(PENDING)
  inventoryHold        InventoryHold  @default(RESERVED)
  reservationExpiresAt DateTime?
  idempotencyKey       String
  deliveryEstimate     String?
  estimatedDelivery    DateTime?
  notes                String?
  cancelReason         String?
  cancelledAt          DateTime?
  deliveredAt          DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  items       OrderItem[]
  payments    Payment[]
  refunds     Refund[]
  history     OrderStatusHistory[]
  orderNotes  OrderNote[]
  redemptions CouponRedemption[]

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([paymentStatus])
  @@index([shipPincode])
  @@index([createdAt])
}

/// Immutable snapshot of what was bought; never updated after creation.
model OrderItem {
  id              String          @id @default(uuid())
  orderId         String
  order           Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId       String?
  variant         ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)
  inventoryId     String
  productName     String
  productSku      String
  variantName     String?
  productImage    String?
  brandName       String?
  quantity        Int
  unitPricePaise  Int
  mrpPaise        Int
  totalPricePaise Int

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id                String          @id @default(uuid())
  orderId           String
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider          PaymentProvider
  amountPaise       Int
  paymentMethod     PaymentMethod
  status            PaymentStatus   @default(PENDING)
  attempt           Int             @default(1)
  /// Provider order id (e.g. Razorpay order_xxx)
  providerOrderId   String?         @unique
  /// Provider payment id (e.g. Razorpay pay_xxx). Unique so a payment is applied once.
  providerPaymentId String?         @unique
  failureReason     String?
  capturedAt        DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  refunds           Refund[]

  @@index([orderId])
}

/// Processed webhook deliveries (idempotency).
model PaymentEvent {
  id          String          @id @default(uuid())
  provider    PaymentProvider
  eventId     String          @unique
  type        String
  payloadHash String
  processedAt DateTime        @default(now())
}

model Refund {
  id               String          @id @default(uuid())
  orderId          String
  order            Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  paymentId        String?
  payment          Payment?        @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  provider         PaymentProvider
  amountPaise      Int
  status           RefundStatus    @default(REQUESTED)
  providerRefundId String?         @unique
  reference        String?
  reason           String
  failureReason    String?
  initiatedById    String?
  initiatedBy      AdminUser?      @relation("RefundInitiator", fields: [initiatedById], references: [id], onDelete: SetNull)
  processedAt      DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([orderId])
  @@index([status])
}

model OrderStatusHistory {
  id               String       @id @default(uuid())
  orderId          String
  order            Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus       OrderStatus?
  toStatus         OrderStatus
  changedByAdminId String?
  changedByAdmin   AdminUser?   @relation("OrderStatusChanger", fields: [changedByAdminId], references: [id], onDelete: SetNull)
  changedByUserId  String?
  /// Human-readable actor: customer, system, payment, or the admin name.
  actor            String
  reason           String?
  createdAt        DateTime     @default(now())

  @@index([orderId, createdAt])
}

model OrderNote {
  id        String     @id @default(uuid())
  orderId   String
  order     Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  adminId   String?
  admin     AdminUser? @relation("OrderNoteAuthor", fields: [adminId], references: [id], onDelete: SetNull)
  note      String
  createdAt DateTime   @default(now())

  @@index([orderId, createdAt])
}

model WishlistItem {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([productId])
}

/// Single-row operational settings (id = "default").
model StoreSettings {
  id                         String   @id @default("default")
  deliveryEnabled            Boolean  @default(true)
  codEnabled                 Boolean  @default(false)
  onlinePaymentEnabled       Boolean  @default(false)
  deliveryFeePaise           Int      @default(4000)
  freeDeliveryThresholdPaise Int      @default(19900)
  minOrderPaise              Int      @default(9900)
  defaultEstimateHours       Int      @default(24)
  operatingHoursStart        String   @default("09:00")
  operatingHoursEnd          String   @default("21:00")
  reservationMinutes         Int      @default(20)
  maxQtyPerLine              Int      @default(10)
  updatedById                String?
  updatedAt                  DateTime @updatedAt
}

model ServiceablePincode {
  id               String   @id @default(uuid())
  pincode          String   @unique
  isServiceable    Boolean  @default(true)
  area             String?
  city             String?
  deliveryFeePaise Int?
  estimateHours    Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([isServiceable])
}

model Coupon {
  id                 String       @id @default(uuid())
  code               String       @unique
  title              String
  description        String
  discountType       DiscountType @default(FIXED)
  /// FIXED: paise. PERCENT: basis points (1000 = 10%).
  discountValue      Int
  minOrderValuePaise Int          @default(0)
  validUntil         DateTime
  isActive           Boolean      @default(true)
  usageLimit         Int?
  usedCount          Int          @default(0)
  source             String       @default("CAMPAIGN")
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  rules       CouponRule[]
  redemptions CouponRedemption[]
}

model CouponRule {
  id        String   @id @default(uuid())
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  ruleType  String
  ruleValue String
  createdAt DateTime @default(now())

  @@index([couponId])
}

model CouponRedemption {
  id         String   @id @default(uuid())
  couponId   String
  coupon     Coupon   @relation(fields: [couponId], references: [id], onDelete: Restrict)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  savedPaise Int
  redeemedAt DateTime @default(now())

  @@index([couponId])
  @@index([userId])
}

model Question {
  id             String   @id @default(uuid())
  productId      String?
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  targetCategory String?
  question       String
  displayOrder   Int      @default(1)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  options   QuestionOption[]
  responses QuestionResponse[]
}

model QuestionOption {
  id            String             @id @default(uuid())
  questionId    String
  question      Question           @relation(fields: [questionId], references: [id], onDelete: Cascade)
  optionText    String
  isRecommended Boolean            @default(false)
  displayOrder  Int                @default(0)
  responses     QuestionResponse[]

  @@index([questionId])
}

model QuestionResponse {
  id         String         @id @default(uuid())
  userId     String?
  user       User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  questionId String
  question   Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  optionId   String
  option     QuestionOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  answeredAt DateTime       @default(now())

  @@index([questionId])
  @@index([optionId])
}

model SystemSettings {
  id        String   @id @default(uuid())
  category  String   @unique
  settings  Json
  updatedBy String?
  updatedAt DateTime @updatedAt
}

model BusinessConfigurations {
  id        String   @id @default(uuid())
  section   String   @unique
  values    Json
  updatedBy String?
  updatedAt DateTime @updatedAt
  version   Int      @default(1)
}

model ConfigurationHistory {
  id         String   @id @default(uuid())
  section    String
  oldValues  Json
  newValues  Json
  changedBy  String
  changeNote String?
  createdAt  DateTime @default(now())

  @@index([section])
}
