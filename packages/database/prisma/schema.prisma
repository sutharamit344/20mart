// 20Mart — single-business catalog, inventory and commerce schema.
// Conventions:
//   * All money is stored as integer PAISE (₹20 = 2000). Never use floats.
//   * UUID primary keys, createdAt/updatedAt on mutable entities.
//   * Constraints Prisma cannot express (CHECKs, partial unique indexes) live in
//     the migration SQL — see migrations/*_p0_foundation/migration.sql.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ───────────────────────────── Enums ─────────────────────────────

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum AdminStatus {
  ACTIVE
  INACTIVE
}

enum CatalogStatus {
  ACTIVE
  INACTIVE
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum StockMovementType {
  INITIAL_STOCK
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
  RESERVATION
  RELEASE
  SALE
  PURCHASE_RECEIPT
  /// Reserved for the later stock-transfer workflow (not used yet).
  TRANSFER_OUT
  TRANSFER_IN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  PACKED
  READY_FOR_DISPATCH
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  FAILED
  REFUNDED // legacy value; refunds are tracked on paymentStatus
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUND_PENDING
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentProvider {
  RAZORPAY
  COD
  MANUAL
}

enum InventoryHold {
  RESERVED
  COMMITTED
  RELEASED
}

enum RefundStatus {
  REQUESTED
  PENDING
  PROCESSED
  FAILED
}

enum InquiryStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum InquiryPriority {
  LOW
  NORMAL
  HIGH
}

enum CartStatus {
  ACTIVE
  CONVERTED
}

enum PaymentMethod {
  ONLINE
  ONLINE_UPI
  CARD
  NET_BANKING
  CASH_ON_DELIVERY
}

enum DeliveryMethod {
  HOME_DELIVERY
  STORE_PICKUP
}

enum DiscountType {
  FIXED
  PERCENT
}

// ─────────────────────── Customer accounts ───────────────────────

/// Customer account. Identity comes from Google's stable subject id.
model User {
  id              String     @id @default(uuid())
  name            String?
  email           String?
  emailVerified   DateTime?
  image           String?
  googleSubjectId String?    @unique
  status          UserStatus @default(ACTIVE)
  lastLoginAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  profile           CustomerProfile?
  sessions          UserSession[]
  wishlist          WishlistItem[]
  inquiries         ContactInquiry[]
  couponGrants      CouponGrant[]
  campaignJoins     CampaignParticipant[]
  campaignCartItems CampaignCartItem[]
  campaignFavorites CampaignFavorite[]
  notifications     Notification[]
  emails            EmailMessage[]
  addresses         Address[]
  carts             Cart[]
  orders            Order[]
  redemptions       CouponRedemption[]
  responses         QuestionResponse[]

  @@index([email])
}

model CustomerProfile {
  id                String   @id @default(uuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone             String?
  marketingOptIn    Boolean  @default(false)
  /// Transactional emails (order, payment, status). In-app notifications are always kept.
  emailOrderUpdates Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

/// Server-side customer session. Only a SHA-256 hash of the cookie token is stored.
model UserSession {
  id         String   @id @default(uuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Address {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         String   @default("Home") // Home, Work, Other
  name         String // recipient full name
  phone        String
  addressLine1 String
  addressLine2 String?
  landmark     String?
  locality     String?
  city         String
  state        String
  pincode      String
  country      String   @default("IN")
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  orders       Order[]

  @@index([userId])
}

// ───────────────────── Admin accounts & RBAC ─────────────────────

/// Staff account. Fully separate from customer `User`.
model AdminUser {
  id                String      @id @default(uuid())
  username          String      @unique
  email             String      @unique
  passwordHash      String
  name              String
  status            AdminStatus @default(ACTIVE)
  lastLoginAt       DateTime?
  failedLoginCount  Int         @default(0)
  lockedUntil       DateTime?
  passwordChangedAt DateTime    @default(now())
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  roles          AdminUserRole[]      @relation("AdminRoles")
  rolesAssigned  AdminUserRole[]      @relation("AdminRoleAssigner")
  sessions       AdminSession[]
  stockMovements StockMovement[]
  auditLogs      AdminAuditLog[]
  purchaseOrders PurchaseOrder[]      @relation("PurchaseOrderCreator")
  goodsReceipts  GoodsReceipt[]       @relation("GoodsReceiptReceiver")
  orderChanges   OrderStatusHistory[] @relation("OrderStatusChanger")
  orderNotes     OrderNote[]          @relation("OrderNoteAuthor")
  refunds        Refund[]             @relation("RefundInitiator")
}

model AdminSession {
  id         String    @id @default(uuid())
  tokenHash  String    @unique
  adminId    String
  admin      AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  lastSeenAt DateTime  @default(now())
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime  @default(now())

  @@index([adminId])
  @@index([expiresAt])
}

/// Login attempts used for throttling admin sign-in (per identifier and per IP).
model AdminLoginAttempt {
  id         String   @id @default(uuid())
  identifier String
  ipAddress  String?
  success    Boolean
  createdAt  DateTime @default(now())

  @@index([identifier, createdAt])
  @@index([ipAddress, createdAt])
}

model Role {
  id          String           @id @default(uuid())
  key         String           @unique // e.g. SUPER_ADMIN
  name        String
  description String?
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  admins      AdminUserRole[]
}

model Permission {
  id          String           @id @default(uuid())
  key         String           @unique // e.g. products.update
  group       String
  description String?
  createdAt   DateTime         @default(now())
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model AdminUserRole {
  adminId      String
  admin        AdminUser  @relation("AdminRoles", fields: [adminId], references: [id], onDelete: Cascade)
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  assignedById String?
  assignedBy   AdminUser? @relation("AdminRoleAssigner", fields: [assignedById], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())

  @@id([adminId, roleId])
  @@index([roleId])
}

model AdminAuditLog {
  id         String     @id @default(uuid())
  adminId    String?
  admin      AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)
  adminName  String
  action     String
  category   String
  entityType String?
  entityId   String?
  details    String
  ipAddress  String?
  createdAt  DateTime   @default(now())

  @@index([adminId])
  @@index([category])
  @@index([createdAt])
}

// ─────────────────────────── Catalog ────────────────────────────

model Category {
  id             String           @id @default(uuid())
  name           String
  slug           String           @unique
  description    String?
  imageUrl       String?
  imageKey       String?
  status         CatalogStatus    @default(ACTIVE)
  displayOrder   Int              @default(0)
  seoTitle       String?
  seoDescription String?
  parentId       String?
  parent         Category?        @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children       Category[]       @relation("CategoryTree")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  products       Product[]
  coupons        CouponCategory[]

  @@index([status, displayOrder])
  @@index([parentId])
}

model Brand {
  id          String        @id @default(uuid())
  name        String
  slug        String        @unique
  description String?
  logoUrl     String?
  logoKey     String?
  status      CatalogStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  products    Product[]

  @@index([status])
  @@index([name])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Brand_name_trgm_idx")
}

/// Merchandising price points (₹20/₹40/₹60/₹100 initially). Admin-manageable.
model PricePoint {
  id           String    @id @default(uuid())
  amountPaise  Int       @unique
  label        String
  isActive     Boolean   @default(true)
  displayOrder Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  products     Product[]
}

model Product {
  id                String        @id @default(uuid())
  name              String
  slug              String        @unique
  sku               String        @unique
  description       String?
  shortDescription  String?
  categoryId        String
  category          Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brandId           String?
  brand             Brand?        @relation(fields: [brandId], references: [id], onDelete: Restrict)
  pricePointId      String?
  pricePoint        PricePoint?   @relation(fields: [pricePointId], references: [id], onDelete: SetNull)
  sellingPricePaise Int
  mrpPaise          Int
  status            ProductStatus @default(DRAFT)
  isFeatured        Boolean       @default(false)
  seoTitle          String?
  seoDescription    String?
  publishedAt       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  images             ProductImage[]
  variants           ProductVariant[]
  inventories        Inventory[]
  cartItems          CartItem[]
  orderItems         OrderItem[]
  questions          Question[]
  wishlistItems      WishlistItem[]
  couponProducts     CouponProduct[]
  campaignProducts   CampaignProduct[]
  campaignCartItems  CampaignCartItem[]
  campaignFavorites  CampaignFavorite[]
  purchaseOrderItems PurchaseOrderItem[]

  @@index([status, categoryId])
  @@index([status, isFeatured])
  @@index([status, createdAt])
  @@index([brandId])
  @@index([pricePointId])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Product_name_trgm_idx")
  @@index([sku(ops: raw("gin_trgm_ops"))], type: Gin, map: "Product_sku_trgm_idx")
}

model ProductImage {
  id         String   @id @default(uuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url        String
  storageKey String?
  altText    String?
  sortOrder  Int      @default(0)
  isPrimary  Boolean  @default(false)
  width      Int?
  height     Int?
  mimeType   String?
  sizeBytes  Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([productId, sortOrder])
}

model ProductVariant {
  id                String        @id @default(uuid())
  productId         String
  product           Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku               String        @unique
  name              String
  sellingPricePaise Int
  mrpPaise          Int
  status            CatalogStatus @default(ACTIVE)
  sortOrder         Int           @default(0)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  inventories        Inventory[]
  cartItems          CartItem[]
  orderItems         OrderItem[]
  purchaseOrderItems PurchaseOrderItem[]

  @@index([productId, sortOrder])
  @@index([sku(ops: raw("gin_trgm_ops"))], type: Gin, map: "ProductVariant_sku_trgm_idx")
}

// ────────────────────────── Inventory ───────────────────────────

/// Stock of one product (variantId NULL) or one variant at one warehouse.
/// "availableQuantity" is the quantity ON HAND (column name kept from P0).
/// Sellable = availableQuantity - reservedQuantity - safetyStock (never below 0).
/// Uniqueness per (warehouse, product/variant) is enforced by partial unique indexes in SQL.
model Inventory {
  id                String          @id @default(uuid())
  warehouseId       String
  warehouse         Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  productId         String
  product           Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId         String?
  variant           ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  availableQuantity Int             @default(0)
  reservedQuantity  Int             @default(0)
  lowStockThreshold Int             @default(10)
  /// Units held back from sale at this warehouse (damage buffer, counting errors).
  safetyStock       Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  movements         StockMovement[]

  @@index([warehouseId])
  @@index([productId])
  @@index([variantId])
  @@index([availableQuantity])
}

model StockMovement {
  id                 String            @id @default(uuid())
  inventoryId        String
  inventory          Inventory         @relation(fields: [inventoryId], references: [id], onDelete: Restrict)
  movementType       StockMovementType
  quantity           Int // signed delta applied to availableQuantity (or reserved for RESERVATION/RELEASE)
  previousQuantity   Int
  newQuantity        Int
  reason             String
  reference          String?
  performedByAdminId String?
  performedBy        AdminUser?        @relation(fields: [performedByAdminId], references: [id], onDelete: SetNull)
  createdAt          DateTime          @default(now())

  @@index([inventoryId, createdAt])
  @@index([performedByAdminId])
}

// ───────────── Commerce (later phases; kept, not used in P0) ─────────────

/// Persistent cart: customer carts (userId) or guest carts (sessionId = SHA-256 of the cookie token).
model Cart {
  id         String     @id @default(uuid())
  userId     String?
  user       User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId  String?    @unique
  status     CartStatus @default(ACTIVE)
  /// Coupon the customer applied; re-validated server-side on every read and at checkout.
  couponCode String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  items      CartItem[]

  @@index([userId, status])
  @@index([updatedAt])
}

model CartItem {
  id              String          @id @default(uuid())
  cartId          String
  cart            Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId       String
  product         Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId       String?
  variant         ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity        Int             @default(1)
  /// Price seen when added (display only, flags price changes). Never charged.
  addedPricePaise Int
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([cartId])
}

model Order {
  id                     String         @id @default(uuid())
  /// Public, non-sequential reference, e.g. ZM261114-7K3QX9
  orderNumber            String         @unique
  userId                 String
  user                   User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  addressId              String?
  address                Address?       @relation(fields: [addressId], references: [id], onDelete: SetNull)
  shipName               String
  shipPhone              String
  shipLine1              String
  shipLine2              String?
  shipLandmark           String?
  shipCity               String
  shipState              String
  shipPincode            String
  shipCountry            String         @default("IN")
  status                 OrderStatus    @default(PENDING)
  subtotalPaise          Int
  deliveryChargePaise    Int            @default(0)
  discountPaise          Int            @default(0)
  taxPaise               Int            @default(0)
  totalPaise             Int
  deliveryMethod         DeliveryMethod @default(HOME_DELIVERY)
  paymentMethod          PaymentMethod
  paymentStatus          PaymentStatus  @default(PENDING)
  inventoryHold          InventoryHold  @default(RESERVED)
  reservationExpiresAt   DateTime?
  idempotencyKey         String
  couponId               String?
  coupon                 Coupon?        @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponCode             String?
  deliveryEstimate       String?
  estimatedDelivery      DateTime?
  notes                  String?
  cancelReason           String?
  cancelledAt            DateTime?
  deliveredAt            DateTime?
  /// Warehouse the whole order is fulfilled from (one warehouse per order).
  fulfillmentWarehouseId String?
  fulfillmentWarehouse   Warehouse?     @relation(fields: [fulfillmentWarehouseId], references: [id], onDelete: Restrict)
  dispatchedAt           DateTime?
  /// Why delivery failed (status FAILED), recorded by operations.
  deliveryFailureReason  String?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  items       OrderItem[]
  payments    Payment[]
  refunds     Refund[]
  history     OrderStatusHistory[]
  orderNotes  OrderNote[]
  redemptions CouponRedemption[]

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([paymentStatus])
  @@index([shipPincode])
  @@index([createdAt])
  @@index([fulfillmentWarehouseId, createdAt])
}

/// Immutable snapshot of what was bought; never updated after creation.
model OrderItem {
  id              String          @id @default(uuid())
  orderId         String
  order           Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId       String?
  variant         ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)
  inventoryId     String
  productName     String
  productSku      String
  variantName     String?
  productImage    String?
  brandName       String?
  quantity        Int
  unitPricePaise  Int
  mrpPaise        Int
  totalPricePaise Int

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id                String          @id @default(uuid())
  orderId           String
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider          PaymentProvider
  amountPaise       Int
  paymentMethod     PaymentMethod
  status            PaymentStatus   @default(PENDING)
  attempt           Int             @default(1)
  /// Provider order id (e.g. Razorpay order_xxx)
  providerOrderId   String?         @unique
  /// Provider payment id (e.g. Razorpay pay_xxx). Unique so a payment is applied once.
  providerPaymentId String?         @unique
  failureReason     String?
  capturedAt        DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  refunds           Refund[]

  @@index([orderId])
}

/// Processed webhook deliveries (idempotency).
model PaymentEvent {
  id          String          @id @default(uuid())
  provider    PaymentProvider
  eventId     String          @unique
  type        String
  payloadHash String
  processedAt DateTime        @default(now())
}

model Refund {
  id               String          @id @default(uuid())
  orderId          String
  order            Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  paymentId        String?
  payment          Payment?        @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  provider         PaymentProvider
  amountPaise      Int
  status           RefundStatus    @default(REQUESTED)
  providerRefundId String?         @unique
  reference        String?
  reason           String
  failureReason    String?
  initiatedById    String?
  initiatedBy      AdminUser?      @relation("RefundInitiator", fields: [initiatedById], references: [id], onDelete: SetNull)
  processedAt      DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([orderId])
  @@index([status])
}

model OrderStatusHistory {
  id               String       @id @default(uuid())
  orderId          String
  order            Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus       OrderStatus?
  toStatus         OrderStatus
  changedByAdminId String?
  changedByAdmin   AdminUser?   @relation("OrderStatusChanger", fields: [changedByAdminId], references: [id], onDelete: SetNull)
  changedByUserId  String?
  /// Human-readable actor: customer, system, payment, or the admin name.
  actor            String
  reason           String?
  createdAt        DateTime     @default(now())

  @@index([orderId, createdAt])
}

model OrderNote {
  id        String     @id @default(uuid())
  orderId   String
  order     Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  adminId   String?
  admin     AdminUser? @relation("OrderNoteAuthor", fields: [adminId], references: [id], onDelete: SetNull)
  note      String
  createdAt DateTime   @default(now())

  @@index([orderId, createdAt])
}

model WishlistItem {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([productId])
}

/// Single-row operational settings (id = "default").
model StoreSettings {
  id                         String   @id @default("default")
  deliveryEnabled            Boolean  @default(true)
  codEnabled                 Boolean  @default(false)
  onlinePaymentEnabled       Boolean  @default(false)
  deliveryFeePaise           Int      @default(4000)
  freeDeliveryThresholdPaise Int      @default(19900)
  minOrderPaise              Int      @default(9900)
  defaultEstimateHours       Int      @default(24)
  operatingHoursStart        String   @default("09:00")
  operatingHoursEnd          String   @default("21:00")
  reservationMinutes         Int      @default(20)
  maxQtyPerLine              Int      @default(10)
  updatedById                String?
  updatedAt                  DateTime @updatedAt
}

model ServiceablePincode {
  id               String        @id @default(uuid())
  pincode          String        @unique
  isServiceable    Boolean       @default(true)
  area             String?
  city             String?
  deliveryFeePaise Int?
  estimateHours    Int?
  zoneId           String?
  zone             DeliveryZone? @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([isServiceable])
  @@index([zoneId])
}

/// Discount code. FIXED values are paise; PERCENT values are basis points (1000 = 10%).
model Coupon {
  id                 String       @id @default(uuid())
  code               String       @unique
  title              String
  description        String?
  discountType       DiscountType @default(FIXED)
  discountValue      Int
  /// Cap for PERCENT coupons (paise). Null = no cap.
  maxDiscountPaise   Int?
  minOrderValuePaise Int          @default(0)
  startsAt           DateTime     @default(now())
  endsAt             DateTime?
  isActive           Boolean      @default(false)
  /// Total redemptions allowed across all customers. Null = unlimited.
  usageLimit         Int?
  /// Redemptions allowed per customer.
  perCustomerLimit   Int          @default(1)
  /// Live count of APPLIED redemptions (kept in step inside the redemption transaction).
  usedCount          Int          @default(0)
  /// Only customers who were issued (granted) the coupon may use it.
  requiresGrant      Boolean      @default(false)
  /// Automatically issue to every new customer on first sign-in.
  autoIssueOnSignup  Boolean      @default(false)
  createdById        String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  products    CouponProduct[]
  categories  CouponCategory[]
  grants      CouponGrant[]
  redemptions CouponRedemption[]
  campaigns   Campaign[]
  orders      Order[]

  @@index([isActive, startsAt])
}

/// Restrict a coupon to specific products (empty = all products, unless categories are set).
model CouponProduct {
  couponId  String
  coupon    Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([couponId, productId])
  @@index([productId])
}

model CouponCategory {
  couponId   String
  coupon     Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([couponId, categoryId])
  @@index([categoryId])
}

/// A coupon issued (distributed) to a customer. Issued is NOT redeemed.
model CouponGrant {
  id         String    @id @default(uuid())
  couponId   String
  coupon     Coupon    @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// WELCOME | CAMPAIGN | MANUAL
  source     String
  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  issuedAt   DateTime  @default(now())

  @@unique([couponId, userId])
  @@index([userId])
  @@index([campaignId])
  @@index([issuedAt])
}

enum RedemptionStatus {
  APPLIED
  REVERSED
}

/// One coupon use on one order. Reversed (not deleted) when the order is cancelled/fails.
model CouponRedemption {
  id            String           @id @default(uuid())
  couponId      String
  coupon        Coupon           @relation(fields: [couponId], references: [id], onDelete: Restrict)
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  orderId       String           @unique
  order         Order            @relation(fields: [orderId], references: [id], onDelete: Restrict)
  discountPaise Int
  status        RedemptionStatus @default(APPLIED)
  redeemedAt    DateTime         @default(now())
  reversedAt    DateTime?

  @@index([couponId, status])
  @@index([userId, couponId])
  @@index([redeemedAt])
}

enum CampaignType {
  PROMOTION
  FILL_YOUR_CART
}

/// Marketing campaign. "Live" = isActive AND startsAt <= now AND (endsAt is null OR endsAt > now).
model Campaign {
  id             String       @id @default(uuid())
  name           String
  slug           String       @unique
  type           CampaignType @default(PROMOTION)
  description    String?
  bannerTitle    String?
  bannerSubtitle String?
  bannerImageUrl String?
  bannerImageKey String?
  isActive       Boolean      @default(false)
  /// Show on the homepage while live.
  showOnHomepage Boolean      @default(true)
  startsAt       DateTime     @default(now())
  endsAt         DateTime?
  couponId       String?
  coupon         Coupon?      @relation(fields: [couponId], references: [id], onDelete: SetNull)
  /// Fill Your Cart: max quantity per product in a saved campaign cart.
  maxQtyPerItem  Int          @default(10)
  displayOrder   Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  products     CampaignProduct[]
  participants CampaignParticipant[]
  cartItems    CampaignCartItem[]
  favorites    CampaignFavorite[]
  grants       CouponGrant[]

  @@index([isActive, startsAt, endsAt])
  @@index([type])
}

model CampaignProduct {
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sortOrder  Int      @default(0)

  @@id([campaignId, productId])
  @@index([productId])
}

/// Fill Your Cart: a customer who joined the campaign (demand signal, not a purchase).
model CampaignParticipant {
  id         String   @id @default(uuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt   DateTime @default(now())

  @@unique([campaignId, userId])
  @@index([userId])
  @@index([joinedAt])
}

/// Fill Your Cart saved item. Never reserves inventory and never becomes an order.
model CampaignCartItem {
  id         String   @id @default(uuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity   Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([campaignId, userId, productId])
  @@index([campaignId, productId])
}

model CampaignFavorite {
  id         String   @id @default(uuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([campaignId, userId, productId])
  @@index([campaignId, productId])
}

enum NotificationType {
  WELCOME
  ORDER_CONFIRMATION
  PAYMENT_CONFIRMATION
  ORDER_STATUS
  ORDER_CANCELLED
  COUPON_ISSUED
  CAMPAIGN_ANNOUNCEMENT
}

/// In-app notification (customer notification centre).
model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt, createdAt])
}

enum EmailStatus {
  QUEUED
  SENT
  DELIVERED
  BOUNCED
  COMPLAINED
  FAILED
  SKIPPED
}

/// Email outbox. SENT = accepted by the provider; DELIVERED/BOUNCED only from provider webhooks.
model EmailMessage {
  id                String           @id @default(uuid())
  userId            String?
  user              User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  type              NotificationType
  toEmail           String
  subject           String
  html              String
  status            EmailStatus      @default(QUEUED)
  provider          String?
  providerMessageId String?          @unique
  attempts          Int              @default(0)
  lastError         String?
  sentAt            DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([status, createdAt])
  @@index([userId])
}

/// Group of PIN codes sharing delivery fee / estimate / minimum order.
model DeliveryZone {
  id               String                  @id @default(uuid())
  name             String                  @unique
  isActive         Boolean                 @default(true)
  deliveryFeePaise Int?
  estimateHours    Int?
  minOrderPaise    Int?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  pincodes         ServiceablePincode[]
  warehouses       WarehouseDeliveryZone[]
}

model Question {
  id             String   @id @default(uuid())
  productId      String?
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  targetCategory String?
  question       String
  displayOrder   Int      @default(1)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  options   QuestionOption[]
  responses QuestionResponse[]
}

model QuestionOption {
  id            String             @id @default(uuid())
  questionId    String
  question      Question           @relation(fields: [questionId], references: [id], onDelete: Cascade)
  optionText    String
  isRecommended Boolean            @default(false)
  displayOrder  Int                @default(0)
  responses     QuestionResponse[]

  @@index([questionId])
}

model QuestionResponse {
  id         String         @id @default(uuid())
  userId     String?
  user       User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  questionId String
  question   Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  optionId   String
  option     QuestionOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  answeredAt DateTime       @default(now())

  @@index([questionId])
  @@index([optionId])
}

model SystemSettings {
  id        String   @id @default(uuid())
  category  String   @unique
  settings  Json
  updatedBy String?
  updatedAt DateTime @updatedAt
}

model BusinessConfigurations {
  id        String   @id @default(uuid())
  section   String   @unique
  values    Json
  updatedBy String?
  updatedAt DateTime @updatedAt
  version   Int      @default(1)
}

model ConfigurationHistory {
  id         String   @id @default(uuid())
  section    String
  oldValues  Json
  newValues  Json
  changedBy  String
  changeNote String?
  createdAt  DateTime @default(now())

  @@index([section])
}

/// Customer messages from the storefront contact form (replaces the old JSON file).
model ContactInquiry {
  id           String          @id @default(uuid())
  /// Public, non-sequential reference shown to the customer, e.g. INQ-7K3QX9
  ticketNumber String          @unique
  userId       String?
  user         User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  name         String
  email        String
  phone        String?
  subject      String
  message      String
  status       InquiryStatus   @default(NEW)
  priority     InquiryPriority @default(NORMAL)
  adminNotes   String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([status, createdAt])
  @@index([email])
}

// ─────────────────────── P4: Warehouses & fulfilment ───────────────────────

enum WarehouseType {
  WAREHOUSE
  FULFILLMENT_CENTER
  STORAGE
  SUPPLIER_DISPATCH
}

enum WarehouseStatus {
  /// Created but not yet verified as operational: never serves customers.
  SETUP
  ACTIVE
  /// Temporarily not accepting new orders (stock is kept).
  PAUSED
  INACTIVE
}

/// A physical inventory / fulfilment location.
model Warehouse {
  id                 String          @id @default(uuid())
  name               String
  code               String          @unique
  type               WarehouseType   @default(WAREHOUSE)
  status             WarehouseStatus @default(SETUP)
  addressLine1       String
  addressLine2       String?
  city               String
  state              String
  country            String          @default("IN")
  pinCode            String
  latitude           Decimal?        @db.Decimal(9, 6)
  longitude          Decimal?        @db.Decimal(9, 6)
  contactName        String?
  contactNumber      String?
  /// Optional cap on new orders assigned per IST day; null = no cap.
  dailyOrderCapacity Int?
  notes              String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  inventories    Inventory[]
  deliveryZones  WarehouseDeliveryZone[]
  orders         Order[]
  purchaseOrders PurchaseOrder[]

  @@index([status])
}

/// Which warehouses may serve which delivery areas (zones), in priority order.
model WarehouseDeliveryZone {
  id               String       @id @default(uuid())
  warehouseId      String
  warehouse        Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  zoneId           String
  zone             DeliveryZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  /// Lower number = tried first.
  priority         Int          @default(1)
  deliveryFeePaise Int?
  estimateHours    Int?
  /// "HH:MM" IST; orders after this are processed from the next operating day.
  cutoffTime       String?
  isActive         Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([warehouseId, zoneId])
  @@index([zoneId, isActive, priority])
}

/// Demand from PIN codes we do not serve yet. Never counted as sales or revenue.
model DeliveryInterest {
  id        String   @id @default(uuid())
  pincode   String
  email     String
  name      String?
  userId    String?
  createdAt DateTime @default(now())

  @@unique([pincode, email])
  @@index([createdAt])
}

// ─────────────────────── P4: Procurement ───────────────────────

enum SupplierStatus {
  ACTIVE
  INACTIVE
}

/// Procurement vendor (not a marketplace seller, not a warehouse).
model Supplier {
  id             String          @id @default(uuid())
  name           String
  contactPerson  String?
  phone          String?
  email          String?
  address        String?
  city           String?
  state          String?
  pinCode        String?
  gstin          String?
  status         SupplierStatus  @default(ACTIVE)
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  purchaseOrders PurchaseOrder[]

  @@index([status, name])
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CLOSED
  CANCELLED
}

/// Creating/ordering a PO never changes inventory; only confirmed GoodsReceipts do.
model PurchaseOrder {
  id           String              @id @default(uuid())
  poNumber     String              @unique
  supplierId   String
  supplier     Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  warehouseId  String
  warehouse    Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  status       PurchaseOrderStatus @default(DRAFT)
  expectedDate DateTime?
  notes        String?
  totalPaise   Int                 @default(0)
  createdById  String?
  createdBy    AdminUser?          @relation("PurchaseOrderCreator", fields: [createdById], references: [id], onDelete: SetNull)
  orderedAt    DateTime?
  closedAt     DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  items        PurchaseOrderItem[]
  receipts     GoodsReceipt[]

  @@index([status, createdAt])
  @@index([supplierId])
  @@index([warehouseId])
}

model PurchaseOrderItem {
  id               String             @id @default(uuid())
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId        String
  product          Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId        String?
  variant          ProductVariant?    @relation(fields: [variantId], references: [id], onDelete: Restrict)
  quantityOrdered  Int
  /// Accepted units added to stock so far.
  quantityReceived Int                @default(0)
  /// Damaged/rejected units reported so far (never added to stock).
  quantityRejected Int                @default(0)
  unitCostPaise    Int
  receiptItems     GoodsReceiptItem[]

  @@index([purchaseOrderId])
  @@index([productId])
}

/// One physical delivery from a supplier, confirmed by an admin.
model GoodsReceipt {
  id              String             @id @default(uuid())
  receiptNumber   String             @unique
  purchaseOrderId String
  purchaseOrder   PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  /// Client key so a double-submitted receipt is applied once.
  idempotencyKey  String             @unique
  receivedById    String?
  receivedBy      AdminUser?         @relation("GoodsReceiptReceiver", fields: [receivedById], references: [id], onDelete: SetNull)
  notes           String?
  createdAt       DateTime           @default(now())
  items           GoodsReceiptItem[]

  @@index([purchaseOrderId, createdAt])
}

model GoodsReceiptItem {
  id                  String            @id @default(uuid())
  goodsReceiptId      String
  goodsReceipt        GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderItemId String
  purchaseOrderItem   PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Restrict)
  quantityAccepted    Int
  quantityRejected    Int               @default(0)
  discrepancyNote     String?

  @@index([goodsReceiptId])
  @@index([purchaseOrderItemId])
}

// ───────────────────── Analytics (behavioural + operational events) ─────────────────────
//
// Raw events are kept apart from business records: no foreign keys, so analytics writes can never
// block or fail a cart/order transaction, and events outlive deleted products.
// Identity fields (userId, visitorId, sessionId) are filled ONLY when the visitor has granted
// analytics consent. Operational events (cart/checkout/stock signals recorded by the server) are
// always stored, but without identity unless consent was given.

enum AnalyticsEventName {
  APP_OPENED
  HOME_VIEWED
  CATEGORY_VIEWED
  PRODUCT_VIEWED
  PRODUCT_SEARCHED
  CART_ITEM_ADDED
  CART_ITEM_REMOVED
  CART_VIEWED
  CHECKOUT_STARTED
  PURCHASE_COMPLETED
  PRODUCT_UNAVAILABLE_VIEWED
  OUT_OF_STOCK_ADD_ATTEMPT
  WISHLIST_ADDED
  DELIVERY_CHECKED
  COUPON_APPLIED
  ORDER_CANCELLED
  /// A refund confirmed by the payment provider. Not a physical product return.
  REFUND_PROCESSED
}

/// BEHAVIORAL = optional, consent-only browsing signals. OPERATIONAL = server-recorded commerce signals.
enum AnalyticsEventCategory {
  BEHAVIORAL
  OPERATIONAL
}

enum AnalyticsEventSource {
  CLIENT
  SERVER
}

model AnalyticsEvent {
  /// Event id; client-generated UUID for browser events (deduplication key), server-generated otherwise.
  id             String                 @id @db.Uuid
  name           AnalyticsEventName
  category       AnalyticsEventCategory
  source         AnalyticsEventSource
  occurredAt     DateTime
  receivedAt     DateTime               @default(now())
  /// Identity — only with analytics consent. visitorId is SHA-256 of the visitor cookie.
  userId         String?
  visitorId      String?
  sessionId      String?
  productId      String?
  variantId      String?
  categoryId     String?
  cartId         String?
  orderId        String?
  warehouseId    String?
  zoneId         String?
  /// Delivery PIN from the server-side location cookie (never from the request body).
  pincode        String?
  quantity       Int?
  /// Unit price looked up on the server at ingestion. Never taken from the client.
  unitPricePaise Int?
  /// Normalised search term (lower-case, PII-like strings removed).
  searchTerm     String?
  resultCount    Int?
  /// Small whitelisted context (e.g. reason codes). Never personal data.
  metadata       Json?

  @@index([name, occurredAt])
  @@index([productId, occurredAt])
  @@index([category, occurredAt])
  @@index([visitorId])
  @@index([sessionId])
}

/// One browsing session of a consenting visitor (30-minute idle timeout by default).
model AnalyticsSession {
  /// SHA-256 of the session cookie (AnalyticsEvent.sessionId refers to this).
  id           String   @id
  visitorId    String
  /// Linked when the visitor is signed in (anonymous → authenticated).
  userId       String?
  startedAt    DateTime @default(now())
  lastSeenAt   DateTime @default(now())
  landingPath  String?
  referrerHost String?
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  deviceType   String?
  eventCount   Int      @default(0)

  @@index([visitorId])
  @@index([userId])
  @@index([startedAt])
  @@index([lastSeenAt])
}

/// Analytics configuration (singleton, id = "default"). Security/audit retention is NOT configured here.
model AnalyticsSettings {
  id                       String    @id @default("default")
  /// Raw behavioural events and sessions are deleted after this many days.
  behavioralRetentionDays  Int       @default(180)
  /// Raw operational events are deleted after this many days; identity is stripped after behavioralRetentionDays.
  operationalRetentionDays Int       @default(365)
  /// A cart with items and no activity for this many hours counts as abandoned.
  cartAbandonmentHours     Int       @default(24)
  sessionIdleMinutes       Int       @default(30)
  /// Bump to ask every visitor for consent again (e.g. after the purposes change).
  consentVersion           Int       @default(1)
  /// When event tracking actually started in this database (time of the first recorded event).
  /// Set once by the daily aggregation; days before it have NO behavioural data (not zero demand).
  trackingStartedAt        DateTime?
  updatedById              String?
  updatedAt                DateTime  @updatedAt
}

/// Bookkeeping for idempotent daily aggregation jobs (one row per job and IST day).
model AnalyticsJobRun {
  id         String    @id @default(uuid())
  job        String
  day        DateTime  @db.Date
  status     String
  rows       Int       @default(0)
  error      String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@unique([job, day])
  @@index([status])
}

// ───────────────────── Analytics Phase C: daily product demand aggregates ─────────────────────

/// How much event tracking covered a day: NONE (before tracking existed — no data, not zero demand),
/// PARTIAL (tracking started during that day) or FULL.
enum AnalyticsCoverage {
  NONE
  PARTIAL
  FULL
}

/// One row per product per IST calendar day. Rebuilt idempotently by the daily aggregation job.
/// Actual sales (from orders) and estimates are kept in separate, clearly named columns.
/// Contains no customer identity.
model ProductDailyAnalytics {
  /// IST calendar day.
  day                 DateTime          @db.Date
  productId           String
  /// Category at aggregation time.
  categoryId          String?
  /// Event coverage for this day; behavioural/operational counts are only meaningful when not NONE.
  eventCoverage       AnalyticsCoverage
  /// Behavioural (consented visitors only, so a lower bound).
  views               Int               @default(0)
  uniqueViewers       Int               @default(0)
  unavailableViews    Int               @default(0)
  /// Operational (all shoppers).
  cartAddUnits        Int               @default(0)
  cartAddEvents       Int               @default(0)
  cartRemoveUnits     Int               @default(0)
  wishlistAdds        Int               @default(0)
  outOfStockAttempts  Int               @default(0)
  outOfStockUnits     Int               @default(0)
  /// ESTIMATE: units refused for stock reasons × server price at the time. Never added to actual sales.
  estLostRevenuePaise Int               @default(0)
  /// ACTUAL sales from orders placed this day (cancelled, failed and unpaid online orders excluded).
  orders              Int               @default(0)
  unitsSold           Int               @default(0)
  /// Gross item-line revenue (before order-level coupons).
  revenuePaise        Int               @default(0)
  cancelledUnits      Int               @default(0)
  failedDeliveryUnits Int               @default(0)
  /// Per IST hour (0–23).
  cartAddUnitsByHour  Int[]
  unitsSoldByHour     Int[]
  /// Availability across ACTIVE warehouses: minutes in the day with no sellable stock anywhere.
  stockoutMinutes     Int               @default(0)
  /// Number of stock rows at active warehouses (0 = not stocked anywhere that day).
  activeStockRows     Int               @default(0)
  inStockAtClose      Boolean           @default(false)
  computedAt          DateTime          @default(now())

  @@id([day, productId])
  @@index([productId, day])
  @@index([categoryId, day])
}

/// One row per stock row (product/variant × warehouse) per IST day, replayed from StockMovement history.
/// Preserves per-warehouse availability and stockout history.
model InventoryDailySnapshot {
  day                    DateTime @db.Date
  inventoryId            String
  productId              String
  variantId              String?
  warehouseId            String
  /// Warehouse status when the snapshot was computed (status history is not recorded).
  warehouseActive        Boolean
  openingAvailable       Int
  openingReserved        Int
  closingAvailable       Int
  closingReserved        Int
  /// Current safety stock (not historised) used for sellable = available − reserved − safety stock.
  safetyStock            Int
  closingSellable        Int
  movements              Int      @default(0)
  /// Minutes of the day this stock row existed.
  trackedMinutes         Int
  stockoutMinutes        Int      @default(0)
  longestStockoutMinutes Int      @default(0)
  stockouts              Int      @default(0)
  /// False when the replay produced impossible (negative) quantities, i.e. history is incomplete.
  consistent             Boolean  @default(true)
  computedAt             DateTime @default(now())

  @@id([day, inventoryId])
  @@index([productId, day])
  @@index([warehouseId, day])
}
